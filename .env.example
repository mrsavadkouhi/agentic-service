# Generate .env with: python3 scripts/init_local_env.py
# Passwords are intentionally empty here; do not reuse production credentials.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
TEMPORAL_DB_PASSWORD=
AGENTIC_DATABASE_URL=
AGENTIC_TEMPORAL_ADDRESS=temporal:7233
AGENTIC_TEMPORAL_NAMESPACE=agentic
AGENTIC_DISPATCH_MODE=observe
AGENTIC_MIRZA_MODE=observe
AGENTIC_DISPATCH_PAUSED=false
AGENTIC_MIRZA_PAUSED=false
AGENTIC_DISPATCH_TASK_QUEUE=agentic-dispatch
AGENTIC_MIRZA_TASK_QUEUE=agentic-mirza
AGENTIC_LOG_LEVEL=INFO
AGENTIC_INTAKE_TOKEN=
AGENTIC_OPERATOR_TOKEN=
# Runtime settings default fixture execution/fault injection to false.
AGENTIC_API_PORT=18080
AGENTIC_POSTGRES_PORT=15432
AGENTIC_TEMPORAL_PORT=17233

# Optional read-only connectors. Empty settings disable each connector.
# Keep read credentials separate from inference and future write credentials.
AGENTIC_SERVICEDESK_URL=
AGENTIC_SERVICEDESK_READ_TOKEN=
# JSON list of verified dedicated n8n ServiceDesk creator IDs.
AGENTIC_SERVICEDESK_LIFECYCLE_CREATOR_IDS=[]
# Operator confirms ALL historical children used the same account. Requires one ID.
# Default false; IDs alone only protect unmatched n8n-created tickets.
AGENTIC_SERVICEDESK_LIFECYCLE_CREATOR_COVERAGE_CONFIRMED=false
# Optional native postgresql:// DSN for a SELECT-only offboarding mapping account.
AGENTIC_OFFBOARDING_DATABASE_URL=
# Optional SELECT-only onboarding index in the same n8n database.
AGENTIC_ONBOARDING_DATABASE_URL=
AGENTIC_DIRECTORY_URL=
AGENTIC_DIRECTORY_READ_TOKEN=
AGENTIC_MIRZA_URL=
AGENTIC_MIRZA_READ_TOKEN=
AGENTIC_MATTERMOST_URL=
AGENTIC_MATTERMOST_READ_TOKEN=
AGENTIC_MATTERMOST_BOT_USERNAME=servicedesk_agent
AGENTIC_CONNECTOR_ALLOW_HTTP=false

# Step 5 is observation only. Both switches default off; no live model calls by default.
AGENTIC_OBSERVATION_LISTENER_ENABLED=false
AGENTIC_OBSERVATION_POLL_SECONDS=60
AGENTIC_OBSERVATION_BATCH_SIZE=4
AGENTIC_INFERENCE_ENABLED=false
# Fixed HTTPS LiteLLM-compatible endpoint. Mirza's gateway uses /api/v1.
AGENTIC_INFERENCE_URL=
# Dedicated inference credential: never reuse ServiceDesk/Mirza admin/read credentials.
AGENTIC_INFERENCE_TOKEN=
AGENTIC_INFERENCE_MODEL=local-qwen3.8
AGENTIC_INFERENCE_TIMEOUT_SECONDS=30
AGENTIC_INFERENCE_REQUEST_LIMIT=3
AGENTIC_INFERENCE_TOOL_LIMIT=2
AGENTIC_INFERENCE_INPUT_TOKEN_LIMIT=20000
AGENTIC_INFERENCE_OUTPUT_TOKEN_LIMIT=2000
AGENTIC_INFERENCE_MAX_COST_USD=0.25
AGENTIC_INFERENCE_DAILY_BUDGET_USD=2
# Required declared upper-bound rates for the selected alias; missing rates disable live inference.
AGENTIC_INFERENCE_INPUT_USD_PER_MILLION=
AGENTIC_INFERENCE_OUTPUT_USD_PER_MILLION=
